<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_vendor_dashboard_client" model="ir.actions.client">
        <field name="name">Vendor Dashboard</field>
        <field name="tag">ad_vendor_dashboard.client_action</field>
    </record>

    <menuitem id="menu_vendor_dashboard_root"
              name="Vendor Dashboard"
              parent="ad_vendor_management.menu_vendor_root"
              sequence="1"
              action="action_vendor_dashboard_client"/>

    <!-- My Products -->
    <record id="action_vendor_my_products" model="ir.actions.act_window">
        <field name="name">My Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('owner_id', '=', uid)]</field>
    </record>

    <!-- Approved Products -->
    <record id="action_vendor_approved_products" model="ir.actions.act_window">
        <field name="name">Approved Products</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('owner_id', '=', uid), ('status', '=', 'approved')]</field>
    </record>

    <!-- Ongoing Orders -->
    <record id="action_vendor_my_orders" model="ir.actions.act_window">
        <field name="name">My Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
    </record>

    <!-- Ongoing Orders -->
    <record id="action_vendor_ongoing_orders" model="ir.actions.act_window">
        <field name="name">Ongoing Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'sent'])]</field>
    </record>

    <!-- Completed Orders -->
    <record id="action_vendor_completed_orders" model="ir.actions.act_window">
        <field name="name">Completed Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['done', 'purchase'])]</field>
    </record>

    <record id="action_vendor_cancelled_orders" model="ir.actions.act_window">
        <field name="name">Cancelled Orders</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['cancel'])]</field>
    </record>

</odoo>
