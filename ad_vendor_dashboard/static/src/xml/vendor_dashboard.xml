<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="ad_vendor_dashboard.MainTemplate">
        <div class="o_vendor_dashboard p-4">
            <h2 class="fw-bold mb-4">Vendor Dashboard</h2>

            <!-- Loading State -->
            <t t-if="state.loading">
                <div class="text-center mt-5">
                    <i class="fa fa-spinner fa-spin fa-2x text-primary"/>
                    <p class="mt-2 text-muted">Loading your data...</p>
                </div>
            </t>

            <!-- Dashboard Content -->
            <t t-else="">
                <!-- ================== SUBSCRIPTION SECTION ================== -->
                <section class="my-4">
                    <h4 class="mb-3 text-secondary border-bottom pb-2">💳 Subscription Details</h4>

                    <t t-if="state.subscription.name">
                        <div class="card shadow-sm p-4">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5 class="text-muted mb-1">Plan Name</h5>
                                    <h4 class="fw-semibold">
                                        <t t-esc="state.subscription.name"/>
                                    </h4>
                                </div>
                                <div>
                                    <span class="badge bg-warning" t-if="state.subscription.status == 'a'">Pending</span>
                                    <span class="badge bg-success" t-elif="state.subscription.status == 'b'">Active</span>
                                    <span class="badge bg-danger" t-elif="state.subscription.status == 'c'">Expired</span>
                                    <span class="badge bg-secondary" t-else="">No Plan</span>
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-md-4 mb-3">
                                    <strong>Recurrence:</strong>
                                    <p class="mb-0 text-muted">
                                        <t t-esc="state.subscription.recurrence or '—'"/>
                                    </p>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <strong>Next Invoice Date:</strong>
                                    <p class="mb-0 text-muted">
                                        <t t-esc="state.subscription.next_invoice_date or '—'"/>
                                    </p>
                                </div>
                                <div class="col-md-4 mb-3">
                                    <strong>Valid Until:</strong>
                                    <p class="mb-0 text-muted">
                                        <t t-esc="state.subscription.recurr_until or '—'"/>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </t>

                    <t t-else="">
                        <div class="alert alert-secondary">
                            <i class="fa fa-info-circle me-2"/>
                                No active subscription found.
                        </div>
                    </t>
                </section>

                <!-- ================== PRODUCTS SECTION ================== -->
                <section class="my-4">
                    <h4 class="mb-3 text-secondary border-bottom pb-2">📦 Product Overview</h4>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div t-on-click="openMyProducts" class="card shadow-sm text-center p-3 dashboard-card">
                                <h5 class="text-muted mb-2">My Products</h5>
                                <h3>
                                    <t t-esc="state.total_products"/>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div t-on-click="openApprovedProducts" class="card shadow-sm text-center p-3 dashboard-card">
                                <h5 class="text-muted mb-2">Approved Products</h5>
                                <h3>
                                    <t t-esc="state.approved_products"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ================== ORDERS SECTION ================== -->
                <section class="my-4">
                    <h4 class="mb-3 text-secondary border-bottom pb-2">🧾 Order Overview</h4>
                    <div class="row g-3">
                        <div class="col-md-3">
                            <div t-on-click="openTotalOrders" class="card shadow-sm text-center p-3 dashboard-card">
                                <h5 class="text-muted mb-2">My Orders</h5>
                                <h3>
                                    <t t-esc="state.total_orders"/>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div t-on-click="openOngoingOrders" class="card shadow-sm text-center p-3 dashboard-card">
                                <h5 class="text-muted mb-2">Ongoing Orders</h5>
                                <h3>
                                    <t t-esc="state.ongoing_orders"/>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div t-on-click="openCompletedOrders" class="card shadow-sm text-center p-3 dashboard-card">
                                <h5 class="text-muted mb-2">Completed Orders</h5>
                                <h3>
                                    <t t-esc="state.completed_orders"/>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div t-on-click="openCancelledOrders" class="card shadow-sm text-center p-3 dashboard-card">
                                <h5 class="text-muted mb-2">Cancelled Orders</h5>
                                <h3>
                                    <t t-esc="state.cancelled_orders"/>
                                </h3>
                            </div>
                        </div>
                    </div>
                </section>
            </t>
        </div>
    </t>
</templates>
